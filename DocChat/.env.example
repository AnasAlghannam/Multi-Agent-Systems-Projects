# Copy this file to `.env` and fill in your key. `.env` is git-ignored.

# Groq API key — required. Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the chat model used by all three agents.
# DOCCHAT_MODEL=llama-3.3-70b-versatile

# Optional: port for the Gradio UI (default 5000).
# DOCCHAT_PORT=5000

# Optional: set to 1 to expose the app via a public Gradio tunnel.
# Leave unset for local-only access — anything you upload stays on your machine.
# DOCCHAT_SHARE=0
