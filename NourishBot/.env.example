# Copy to `.env` and fill in. `.env` is git-ignored.

# Groq API key — required. Free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: text model used by all agents.
# NOURISH_TEXT_MODEL=llama-3.3-70b-versatile

# Optional: a vision-capable model, if your account has one (e.g. a llama-4
# multimodal model). Leave blank to enter ingredients manually instead.
NOURISH_VISION_MODEL=

# Optional: Gradio port (default 7862).
# APP_PORT=7862
