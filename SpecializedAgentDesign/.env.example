# Copy to `.env` and fill in. `.env` is git-ignored.

# Groq API key — required. Free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: model and endpoint. Any OpenAI-compatible endpoint works.
# MODEL_ID=llama-3.3-70b-versatile
# BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# OpenRouter (optional alternative provider)
# ---------------------------------------------------------------------------
# OpenRouter is OpenAI-compatible and fronts many models behind one key, which
# is useful when Groq's free-tier quota runs out or you need a model Groq does
# not host - including vision-capable ones.
#
# When OPENROUTER_API_KEY is set, projects with a central model config prefer it
# over Groq automatically. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use on OpenRouter (provider-prefixed).
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# Langfuse tracing (optional)
# ---------------------------------------------------------------------------
# With these set, every model call and agent step is traced to a dashboard -
# which agent ran, what it was sent, what came back, tokens and latency.
# Leave them blank and nothing changes. Free tier: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
